{
  "Llm": {
    // Any OpenAI-compatible endpoint: leave Endpoint empty for api.openai.com,
    // or e.g. "http://localhost:11434/v1" for Ollama. Key: env var Llm__ApiKey or OPENAI_API_KEY.
    "ModelId": "gpt-4.1-mini",
    "Endpoint": "",
    "ApiKey": "",
    // Guardrail (Level 1): cap on the completion length of every single LLM request
    "MaxTokensPerRequest": 400,
    // Guardrail (Level 1): cap on all tokens (prompt + completion) spent in one session
    "MaxTokensPerSession": 20000,
    // Guardrail (Level 3): stops runaway tool-calling loops within one user turn
    "MaxToolCallsPerTurn": 6
  },
  "MedStorage": {
    "CatalogUrl": "http://localhost:5001",
    "InventoryUrl": "http://localhost:5002",
    // Least privilege: the LLM never chooses the kit, it can only act on this one
    "DefaultKitId": "11111111-1111-1111-1111-111111111111"
  }
}
